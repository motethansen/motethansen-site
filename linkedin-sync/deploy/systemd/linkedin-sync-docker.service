[Unit]
Description=Sync LinkedIn articles into Cloudflare KV (Docker)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Adjust WorkingDirectory/ExecStart to wherever the repo lives on the droplet.
# enable-schedule.sh writes a drop-in with the resolved absolute path, so you
# normally do NOT edit this file by hand.
WorkingDirectory=/opt/motethansen-site/linkedin-sync
ExecStart=/opt/motethansen-site/linkedin-sync/deploy/docker-run.sh
# Optional hardening: run as a user in the `docker` group that owns the checkout.
# User=deploy
